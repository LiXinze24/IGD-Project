{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IGD task plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement",
    "tasks"
  ],
  "properties": {
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "PD",
              "PM",
              "PA"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "inputs": {
            "type": "object"
          }
        }
      }
    }
  }
}
