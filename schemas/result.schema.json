{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IGD functional workflow result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload"
  ],
  "properties": {
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "parameters",
            "units"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "minProperties": 1
            },
            "units": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "cadquery_code"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "cadquery_code": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "cadquery_code",
            "components"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "cadquery_code": {
              "type": "string",
              "minLength": 1
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            }
          }
        }
      ]
    },
    "quality": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
