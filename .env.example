# This file contains configuration names only. Copy to .env and supply your keys.
IGD_DIFY_BASE_URL=https://api.dify.ai/v1
IGD_DIFY_USER=igd-client
IGD_DIFY_TIMEOUT_SECONDS=180

# Each role uses the API key of its own published Dify Workflow app.
# TP is required for both --requirement and --plan; it coordinates every round.
# Configure functional keys for the roles used by the plan (gear shaft: PD and PM).
IGD_DIFY_TP_API_KEY=
IGD_DIFY_PD_API_KEY=
IGD_DIFY_PM_API_KEY=
IGD_DIFY_PA_API_KEY=

# Optional role-specific endpoint overrides (full workflow API URLs).
# IGD_DIFY_TP_URL=https://dify.example.org/v1/workflows/run
# IGD_DIFY_PD_URL=https://dify.example.org/v1/workflows/run
# IGD_DIFY_PM_URL=https://dify.example.org/v1/workflows/run
# IGD_DIFY_PA_URL=https://dify.example.org/v1/workflows/run

# A workflow receives one JSON string variable; default name: request.
# IGD_DIFY_PD_INPUT_KEY=request
# A result can be a JSON object or a string containing a JSON object.
# IGD_DIFY_PD_RESULT_PATH=data.outputs.result
# The same INPUT_KEY and RESULT_PATH overrides are available for TP, PM and PA.
