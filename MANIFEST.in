include .gitignore README.md README.zh-CN.md LICENSE CITATION.cff .env.example
recursive-include docs *.md
include docs/assets/shaft-preview.png
recursive-include schemas *.json
recursive-include examples *.py *.json
recursive-include tools *.py
recursive-include tests *.py
include .github/workflows/ci.yml
include training/llamafactory/README.md
include training/llamafactory/qwen2_5coder_lora_s1_sft.yaml
